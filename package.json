{
  "name": "ramen-schema",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "author": {
    "name": "Sebastian Enns",
    "email": "mail@sebenns.com",
    "url": "https://www.sebenns.com"
  },
  "private": true,
  "scripts": {
    "schemas:export": "node scripts/export-specifications.mjs",
    "prestart": "npm run schemas:export",
    "start": "docusaurus start",
    "prebuild": "npm run schemas:export",
    "build": "docusaurus build",
    "serve": "docusaurus serve",
    "typecheck": "tsc",
    "format": "prettier --check docs src scripts docusaurus.config.ts sidebars.ts package.json README.md .github/workflows",
    "format:fix": "prettier --write docs src scripts docusaurus.config.ts sidebars.ts package.json README.md .github/workflows",
    "deploy:pages": "npm run build",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/faster": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@ramen-suite/core": "0.1.0",
    "@types/react": "^19.0.0",
    "prettier": "^3.8.4",
    "typescript": "~6.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
